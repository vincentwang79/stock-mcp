<service>
  <id>StockMcpTunnel</id>
  <name>StockMcpTunnel</name>
  <description>Outbound-only Secure MCP Tunnel for the local Stock MCP service.</description>
  <executable>powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;__INSTALL_ROOT__\current\deploy\services\run-tunnel.ps1&quot; -InstallRoot &quot;__INSTALL_ROOT__&quot;</arguments>
  <workingdirectory>__INSTALL_ROOT__\current</workingdirectory>
  <logpath>__INSTALL_ROOT__\logs</logpath>
  <autoRefresh>false</autoRefresh>
  <stoptimeout>30 sec</stoptimeout>
  <log mode="roll-by-size-time"><sizeThreshold>10485760</sizeThreshold><pattern>yyyy-MM-dd</pattern><keepFiles>14</keepFiles></log>
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="none" />
</service>
